# Salin berkas ini menjadi .env dan isi nilainya. Lihat README.md.

# Connection string PostgreSQL. Kalau pakai Supabase (lewat integrasi
# Vercel Storage), pakai nilai dari:
#   DATABASE_URL  <- salin dari variabel POSTGRES_PRISMA_URL (pooled)
#   DIRECT_URL    <- salin dari variabel POSTGRES_URL_NON_POOLING (langsung)
# Untuk Postgres lain (Neon/Vercel Postgres/lokal) tanpa pooler, isi
# DIRECT_URL dengan nilai yang sama seperti DATABASE_URL.
DATABASE_URL=""
DIRECT_URL=""

# Generate dengan: openssl rand -base64 32
AUTH_SECRET=""

# Diisi otomatis oleh Vercel saat Blob store dihubungkan ke proyek
# (Storage -> Create Database -> Blob). Kosongkan untuk pengembangan lokal —
# lib/storage.ts otomatis memakai disk lokal (folder storage/) jika variabel
# ini tidak diset.
BLOB_READ_WRITE_TOKEN=""
