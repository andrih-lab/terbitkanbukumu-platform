# Salin berkas ini menjadi .env dan isi nilainya. Lihat README.md.

# Connection string PostgreSQL. Kalau pakai Supabase (lewat integrasi
# Vercel Storage), pakai nilai dari:
#   DATABASE_URL  <- salin dari variabel POSTGRES_PRISMA_URL (pooled)
#   DIRECT_URL    <- salin dari variabel POSTGRES_URL_NON_POOLING (langsung)
# Untuk Postgres lain (Neon/Vercel Postgres/lokal) tanpa pooler, isi
# DIRECT_URL dengan nilai yang sama seperti DATABASE_URL.
DATABASE_URL=""
DIRECT_URL=""

# Generate dengan: openssl rand -base64 32
AUTH_SECRET=""

# Diisi otomatis oleh Vercel saat Blob store dihubungkan ke proyek
# (Storage -> Create Database -> Blob). Kosongkan untuk pengembangan lokal —
# lib/storage.ts otomatis memakai disk lokal (folder storage/) jika variabel
# ini tidak diset.
BLOB_READ_WRITE_TOKEN=""

# Path ke binary Chromium/headless-shell yang dipakai puppeteer-core untuk
# render PDF buku (lib/manuscript/render.ts). Di VPS AlmaLinux, contoh:
#   PUPPETEER_EXECUTABLE_PATH="/usr/lib64/chromium-browser/headless_shell"
PUPPETEER_EXECUTABLE_PATH=""

# API key dari resend.com, dipakai lib/email.ts untuk kirim email verifikasi
# pendaftaran.
RESEND_API_KEY=""

# Alamat pengirim email. Sebelum domain sendiri diverifikasi di Resend,
# bisa pakai "onboarding@resend.dev" (hanya bisa kirim ke email pemilik
# akun Resend, cukup untuk tes). Setelah domain terverifikasi, pakai
# alamat di domain sendiri, mis. "TerbitkanBukumu <noreply@terbitkanbukumu.com>".
EMAIL_FROM=""

# Base URL aplikasi (tanpa trailing slash), dipakai membangun tautan
# verifikasi email yang absolut, mis. "https://www.terbitkanbukumu.com".
APP_URL=""

# Kredensial Midtrans (Settings -> Access Keys -> General Credentials di
# dashboard Midtrans). Pakai dashboard Sandbox dulu untuk testing
# (dashboard.sandbox.midtrans.com, environment terpisah dari Production).
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
# "true" hanya kalau key di atas adalah key Production.
MIDTRANS_IS_PRODUCTION="false"
